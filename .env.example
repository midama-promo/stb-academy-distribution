# STB Academy - Distribution deployment
NODE_ENV=production
REQUIRE_NEON_DATABASE=true
APP_URL=https://YOUR-RENDER-SERVICE.onrender.com
PORT=3000

# Dedicated Neon database created specifically for STB Academy
STB_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate independent random secrets (at least 32 bytes each)
STB_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
OTP_HASH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
DOWNLOAD_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Transactional email provider
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=STB Academy - Distribution <no-reply@YOUR-VERIFIED-DOMAIN>
ADMIN_NOTIFICATION_EMAIL=mxldiroba@gmail.com,external.usage8@yahoo.com

# Dedicated Cloudflare R2 bucket created for STB Academy
STB_R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
STB_R2_BUCKET_NAME=YOUR_NEW_STB_BUCKET_NAME
STB_R2_ACCESS_KEY_ID=YOUR_NEW_R2_ACCESS_KEY_ID
STB_R2_SECRET_ACCESS_KEY=YOUR_NEW_R2_SECRET_ACCESS_KEY
